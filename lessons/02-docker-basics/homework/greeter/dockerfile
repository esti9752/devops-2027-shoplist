  from python
#הגדרת תיקיית העבודה הראשית
  workdir /app
# העתקת קובץ התלויות לפני ששאר הקוד מועתק כדי לייעל את ה-cache
  COPY requirments.txt
# התקנת התלויות מתוך הקובץ לפני העתקת שאר קוד המקור
    RUN pip install --no-cache-dir -r requirements.txt
# העתקת שאר קבצי הפרויקט אל תוך הקונטיינר
  COPY . .
   # הגדרת הפורט הנכון שבו האפליקציה תפעל
  EXPOSE 8000 
    # הפעלת האפליקציה בצורת exec עם סוגריים מרובעים
CMD ["python", "main.py"]
